# ==== Database ====
# Contoh untuk PostgreSQL di VPS sendiri (lihat README bagian "Setup Database")
DATABASE_URL="postgresql://toko_user:PASSWORD_AMAN@localhost:5432/toko_online?schema=public"

# ==== Xendit ====
# Ambil dari dashboard.xendit.co -> Settings -> API Keys
# PENTING: pakai Secret Key, JANGAN Public Key
XENDIT_SECRET_KEY="xnd_development_xxxxxxxxxxxxxxxxxxxxxxxx"

# Token verifikasi webhook, dari dashboard.xendit.co -> Settings -> Webhooks -> Verification Token
XENDIT_WEBHOOK_TOKEN="isi-dengan-token-dari-dashboard-xendit"

# ==== Google Sheet (sistem autopilot Anda) ====
# Isi setelah deploy apps-script/WebIntegration.gs sebagai Web App (lihat README Bagian 5)
# URL akan berakhiran /exec
GOOGLE_SCRIPT_URL="https://script.google.com/macros/s/GANTI_DENGAN_ID_DEPLOYMENT_ANDA/exec"
# HARUS SAMA PERSIS dengan WEB_API_KEY di file apps-script/WebIntegration.gs
GOOGLE_SCRIPT_KEY="samakan-persis-dengan-WEB_API_KEY-di-Apps-Script"

# Dipakai cron job di VPS untuk otorisasi panggilan sinkron stok otomatis (bebas, boleh acak)
CRON_SECRET="ganti-dengan-string-acak"

# ==== Admin ====
# Dipakai untuk login ke /admin. Ganti sebelum deploy!
ADMIN_EMAIL="admin@tokosaya.com"
ADMIN_PASSWORD="ganti-dengan-password-kuat"

# Secret acak untuk menandatangani cookie sesi admin (boleh generate: openssl rand -hex 32)
SESSION_SECRET="ganti-dengan-string-acak-panjang"

# URL publik website Anda (dipakai untuk generate webhook callback, dsb)
NEXT_PUBLIC_BASE_URL="https://tokosaya.com"
